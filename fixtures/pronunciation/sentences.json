{
  "version": 1,
  "locale": "zh-TW",
  "note": "發音試聽用句子。listen_for 是要特別聽的字與台灣慣用讀音；expected 只是參考，最後以聽感為準。全部為合成句子。",
  "sentences": [
    { "id": "p01", "text": "這波先把垃圾清掉，等一下再衝。", "listen_for": [{ "chars": "垃圾", "expected": "lè sè" }] },
    { "id": "p02", "text": "銀行那條路走不通，我們改行動路線。", "listen_for": [{ "chars": "銀行", "expected": "yín háng" }, { "chars": "行動", "expected": "xíng dòng" }] },
    { "id": "p03", "text": "隊長說要長期抗戰，這局會很長。", "listen_for": [{ "chars": "隊長", "expected": "zhǎng" }, { "chars": "長期", "expected": "cháng" }] },
    { "id": "p04", "text": "我覺得對面得分得太輕鬆了。", "listen_for": [{ "chars": "覺得", "expected": "de（輕聲）" }, { "chars": "得分", "expected": "dé" }] },
    { "id": "p05", "text": "這個道具要重複使用，重量不重。", "listen_for": [{ "chars": "重複", "expected": "chóng" }, { "chars": "重量", "expected": "zhòng" }] },
    { "id": "p06", "text": "他還沒還血，還在拖時間。", "listen_for": [{ "chars": "還沒", "expected": "hái" }, { "chars": "還血", "expected": "huán xiě" }] },
    { "id": "p07", "text": "企業級的操作，攜帶兩個液體道具。", "listen_for": [{ "chars": "企業", "expected": "qì" }, { "chars": "攜帶", "expected": "xī" }, { "chars": "液體", "expected": "yì" }] },
    { "id": "p08", "text": "蝸牛速度也能贏，危險但值得。", "listen_for": [{ "chars": "蝸牛", "expected": "guā" }, { "chars": "危險", "expected": "wéi" }] },
    { "id": "p09", "text": "骰子丟出六點，這波運氣不錯。", "listen_for": [{ "chars": "骰子", "expected": "tóu zi" }] },
    { "id": "p10", "text": "我很期待下一局，這期的地圖很熟。", "listen_for": [{ "chars": "期待", "expected": "qí" }, { "chars": "熟", "expected": "shóu（口語）或 shú" }] },
    { "id": "p11", "text": "站在崖邊別動，等它曝光再打。", "listen_for": [{ "chars": "崖", "expected": "yái" }, { "chars": "曝光", "expected": "pù" }] },
    { "id": "p12", "text": "大夫說要休息，工夫還是要下。", "listen_for": [{ "chars": "大夫", "expected": "dài fu" }, { "chars": "工夫", "expected": "gōng fu" }] },
    { "id": "p13", "text": "這關的音樂很好聽，樂趣在後面。", "listen_for": [{ "chars": "音樂", "expected": "yuè" }, { "chars": "樂趣", "expected": "lè" }] },
    { "id": "p14", "text": "數一下數量，數字對不對。", "listen_for": [{ "chars": "數一下", "expected": "shǔ" }, { "chars": "數量", "expected": "shù" }] },
    { "id": "p15", "text": "教練教我們的打法，教學影片有。", "listen_for": [{ "chars": "教練", "expected": "jiào" }, { "chars": "教我們", "expected": "jiāo" }] },
    { "id": "p16", "text": "少來，少數人才會這樣打。", "listen_for": [{ "chars": "少來", "expected": "shǎo" }, { "chars": "少數", "expected": "shǎo" }] },
    { "id": "p17", "text": "看好了，好玩的來了。", "listen_for": [{ "chars": "看好", "expected": "hǎo" }, { "chars": "好玩", "expected": "hào" }] },
    { "id": "p18", "text": "不要發呆，頭髮都白了。", "listen_for": [{ "chars": "發呆", "expected": "fā" }, { "chars": "頭髮", "expected": "fǎ" }] },
    { "id": "p19", "text": "當然要當機立斷，當作沒看到。", "listen_for": [{ "chars": "當然", "expected": "dāng" }, { "chars": "當作", "expected": "dàng" }] },
    { "id": "p20", "text": "為了勝利，因為這局很重要。", "listen_for": [{ "chars": "為了", "expected": "wèi" }, { "chars": "因為", "expected": "wèi" }] },
    { "id": "p21", "text": "血量剩一點，流血了。", "listen_for": [{ "chars": "血量", "expected": "xiě 或 xuè" }] },
    { "id": "p22", "text": "和你說，我和他和好了。", "listen_for": [{ "chars": "和", "expected": "hé 或 hàn" }] },
    { "id": "p23", "text": "有人問這局能不能翻盤，我覺得有戲。", "listen_for": [{ "chars": "翻盤", "expected": "fān pán" }] },
    { "id": "p24", "text": "剛那波閃避太帥了，反應好快。", "listen_for": [{ "chars": "閃避", "expected": "shǎn bì" }] },
    { "id": "p25", "text": "先穩住，別急著衝，看下一步。", "listen_for": [{ "chars": "穩住", "expected": "wěn zhù" }] },
    { "id": "p26", "text": "對面在偷分，我們要補位。", "listen_for": [{ "chars": "偷分", "expected": "tōu fēn" }] },
    { "id": "p27", "text": "這局節奏很快，跟不上就先守。", "listen_for": [{ "chars": "節奏", "expected": "jié zòu" }] },
    { "id": "p28", "text": "BOSS 第二階段開始了，注意腳下。", "listen_for": [{ "chars": "BOSS", "expected": "英文讀法" }, { "chars": "腳下", "expected": "jiǎo" }] },
    { "id": "p29", "text": "剩三十秒，二比一，還有機會。", "listen_for": [{ "chars": "三十秒", "expected": "數字讀法" }, { "chars": "二比一", "expected": "èr bǐ yī" }] },
    { "id": "p30", "text": "漂亮！", "listen_for": [{ "chars": "漂亮", "expected": "piào liang" }] },
    { "id": "p31", "text": "哇，差一點，太可惜了。", "listen_for": [{ "chars": "語氣", "expected": "自然的驚嘆" }] },
    { "id": "p32", "text": "欸，這招有名字嗎？我也想學。", "listen_for": [{ "chars": "欸", "expected": "ēi/èi 口語" }] },
    { "id": "p33", "text": "謝謝大家的留言，我都有在看。", "listen_for": [{ "chars": "留言", "expected": "liú yán" }] },
    { "id": "p34", "text": "這個角色的技能冷卻很長，要抓時機。", "listen_for": [{ "chars": "角色", "expected": "jiǎo sè（台灣）或 jué sè" }, { "chars": "冷卻", "expected": "què" }] },
    { "id": "p35", "text": "尾巴的法文不會唸，不過遊戲很好玩。", "listen_for": [{ "chars": "法文", "expected": "fà（台灣）或 fǎ" }] },
    { "id": "p36", "text": "包括這一局，我們總共贏了三場。", "listen_for": [{ "chars": "包括", "expected": "guā（台灣）或 kuò" }] },
    { "id": "p37", "text": "這個成績夠了，質量也不錯。", "listen_for": [{ "chars": "成績", "expected": "jī" }, { "chars": "質量", "expected": "zhí（台灣）" }] },
    { "id": "p38", "text": "暫停一下，我喝口水。", "listen_for": [{ "chars": "暫停", "expected": "zhàn（台灣）或 zàn" }] },
    { "id": "p39", "text": "研究一下對面的套路，突襲他們。", "listen_for": [{ "chars": "研究", "expected": "yán jiù" }, { "chars": "突襲", "expected": "tú xí" }] },
    { "id": "p40", "text": "一時興起就衝了，結果興高采烈地贏了。", "listen_for": [{ "chars": "興起", "expected": "xìng" }, { "chars": "興高采烈", "expected": "xìng" }] }
  ]
}
